<?xml version="1.0" encoding="utf-8"?>
<!-- Streak ring toward the next milestone, as on the profile card. The
     ProgressBar is rotated so the arc starts at the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:innerRadiusRatio="2.6"
            android:shape="ring"
            android:thicknessRatio="10"
            android:useLevel="false">
            <solid android:color="@color/widget_accent_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <shape
            android:innerRadiusRatio="2.6"
            android:shape="ring"
            android:thicknessRatio="10"
            android:useLevel="true">
            <gradient
                android:endColor="@color/widget_accent"
                android:startColor="@color/widget_accent_light"
                android:type="sweep" />
        </shape>
    </item>
</layer-list>
