<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card like GlassContainer: surface fill, a soft sheen from the top
     corner and a hairline rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#00FFFFFF"
                android:centerX="0.45"
                android:endColor="#00FFFFFF"
                android:startColor="@color/widget_sheen"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/widget_rim" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
