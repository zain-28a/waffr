<?xml version="1.0" encoding="utf-8"?>
<!-- Round glass button on a card, like the balance card's corner actions. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_button_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/widget_rim" />
        </shape>
    </item>
</layer-list>
