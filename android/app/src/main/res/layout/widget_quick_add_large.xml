<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add, large: the add buttons and the four latest records. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_icon_tile">
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_receipt" />
    </FrameLayout>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/tajawal_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_recent_title"
        android:textColor="@color/widget_text_primary"
        android:textSize="13.5sp"
        android:layout_marginStart="9dp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal" android:layout_marginTop="12dp">
    <LinearLayout
        android:id="@+id/quick_add_expense"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_expense" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_add_expense"
            android:textColor="@color/widget_text_primary"
            android:textSize="13.5sp"
            android:layout_marginStart="7dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="10dp"
        android:layout_height="1dp"
        android:orientation="horizontal" />
    <LinearLayout
        android:id="@+id/quick_add_income"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_income" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_add_income"
            android:textColor="@color/widget_text_primary"
            android:textSize="13.5sp"
            android:layout_marginStart="7dp" />
    </LinearLayout>
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:orientation="vertical" />
<TextView
    android:id="@+id/recent_empty"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="@font/tajawal_medium"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:text="@string/widget_recent_empty"
    android:textColor="@color/widget_text_secondary"
    android:textSize="12.5sp"
    android:layout_marginTop="10dp"
    android:visibility="gone" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal" android:id="@+id/recent_row_0"
    android:layout_marginTop="8dp">
    <ImageView
        android:id="@+id/recent_dot_0"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_dot" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="9dp">
        <TextView
            android:id="@+id/recent_title_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/recent_day_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/recent_amount_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="13.5sp"
        android:layout_marginStart="6dp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal" android:id="@+id/recent_row_1"
    android:layout_marginTop="8dp">
    <ImageView
        android:id="@+id/recent_dot_1"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_dot" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="9dp">
        <TextView
            android:id="@+id/recent_title_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/recent_day_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/recent_amount_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="13.5sp"
        android:layout_marginStart="6dp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal" android:id="@+id/recent_row_2"
    android:layout_marginTop="8dp">
    <ImageView
        android:id="@+id/recent_dot_2"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_dot" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="9dp">
        <TextView
            android:id="@+id/recent_title_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/recent_day_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/recent_amount_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="13.5sp"
        android:layout_marginStart="6dp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal" android:id="@+id/recent_row_3"
    android:layout_marginTop="8dp">
    <ImageView
        android:id="@+id/recent_dot_3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_dot" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="9dp">
        <TextView
            android:id="@+id/recent_title_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/recent_day_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/recent_amount_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="13.5sp"
        android:layout_marginStart="6dp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical" />
</LinearLayout>
