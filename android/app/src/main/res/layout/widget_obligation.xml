<?xml version="1.0" encoding="utf-8"?>
<!-- Next bill, small: name, amount and when it is due. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_icon_tile">
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_event" />
    </FrameLayout>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/tajawal_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_obligation_title"
        android:textColor="@color/widget_text_primary"
        android:textSize="13.5sp"
        android:layout_marginStart="9dp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical" />
<TextView
    android:id="@+id/obligation_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="@font/tajawal_bold"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="@color/widget_text_primary"
    android:textSize="15sp" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal" android:id="@+id/obligation_amount_row"
    android:layout_marginTop="3dp">
    <TextView
        android:id="@+id/obligation_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="22sp" />
    <TextView
        android:id="@+id/obligation_currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/tajawal_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:layout_marginStart="5dp" />
</LinearLayout>
<TextView
    android:id="@+id/obligation_when"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="@font/tajawal_bold"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="@color/widget_accent"
    android:textSize="12sp"
    android:layout_marginTop="6dp"
    android:background="@drawable/widget_chip"
    android:paddingStart="9dp"
    android:paddingTop="3dp"
    android:paddingEnd="9dp"
    android:paddingBottom="3dp" />
</LinearLayout>
