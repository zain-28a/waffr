<?xml version="1.0" encoding="utf-8"?>
<!-- This month, large: spent, income and the four largest categories with their shares. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/widget_icon_tile">
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_chart" />
    </FrameLayout>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/tajawal_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_month_title"
        android:textColor="@color/widget_text_primary"
        android:textSize="13.5sp"
        android:layout_marginStart="9dp" />
    <TextView
        android:id="@+id/month_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/tajawal_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="12dp"
    android:orientation="vertical" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_month_spent"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/month_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="17sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_month_income"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/month_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="17sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:background="@color/widget_rim"
    android:orientation="horizontal" />
<TextView
    android:id="@+id/month_note"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="@font/tajawal_medium"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="@color/widget_text_secondary"
    android:textSize="12.5sp"
    android:visibility="gone" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:id="@+id/month_row_0"
    android:layout_marginTop="7dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/month_dot_0"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/month_name_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="7dp" />
        <TextView
            android:id="@+id/month_amount_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/month_percent_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:minWidth="34dp"
            android:gravity="end" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/month_bar_0"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:mirrorForRtl="true"
        android:progressDrawable="@drawable/widget_progress_neutral" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:id="@+id/month_row_1"
    android:layout_marginTop="7dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/month_dot_1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/month_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="7dp" />
        <TextView
            android:id="@+id/month_amount_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/month_percent_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:minWidth="34dp"
            android:gravity="end" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/month_bar_1"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:mirrorForRtl="true"
        android:progressDrawable="@drawable/widget_progress_neutral" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:id="@+id/month_row_2"
    android:layout_marginTop="7dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/month_dot_2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/month_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="7dp" />
        <TextView
            android:id="@+id/month_amount_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/month_percent_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:minWidth="34dp"
            android:gravity="end" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/month_bar_2"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:mirrorForRtl="true"
        android:progressDrawable="@drawable/widget_progress_neutral" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" android:id="@+id/month_row_3"
    android:layout_marginTop="7dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/month_dot_3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
        <TextView
            android:id="@+id/month_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/tajawal_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="7dp" />
        <TextView
            android:id="@+id/month_amount_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/month_percent_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:layout_marginStart="6dp"
            android:minWidth="34dp"
            android:gravity="end" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/month_bar_3"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:mirrorForRtl="true"
        android:progressDrawable="@drawable/widget_progress_neutral" />
</LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical" />
</LinearLayout>
