<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the dashboard balance card (_BalanceCard in
     lib/screens/offline/home/dashboard.dart). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/tajawal_medium"
                android:text="@string/widget_balance_title"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/balance_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_accent"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/balance_currency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/tajawal_medium"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/balance_add_expense"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/widget_add_expense"
            android:padding="10dp"
            android:src="@drawable/ic_widget_expense" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/balance_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/tajawal_bold"
        android:gravity="end"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12.5sp" />

    <ProgressBar
        android:id="@+id/balance_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:maxHeight="20dp"
        android:minHeight="20dp"
        android:mirrorForRtl="true"
        android:progressDrawable="@drawable/widget_progress_accent" />

    <TextView
        android:id="@+id/balance_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:fontFamily="@font/tajawal_medium"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12.5sp" />
</LinearLayout>
